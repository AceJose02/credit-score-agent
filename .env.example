# Copy this file to .env and fill in at least one key.
# .env is ignored by git; never commit real keys.

# Create a key in the Claude Console: https://platform.claude.com
ANTHROPIC_API_KEY=

# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Optional ──────────────────────────────────────────────────
# Default model for each provider (the UI still lets you switch).
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-6-sol

# PORT=3000
# The server only listens on this computer by default.
# Set HOST=0.0.0.0 to reach it from other devices on your network
# (anyone who can reach it can spend your API credits).
# HOST=127.0.0.1
